diff --git a/extra/pandoc_filter/markdownized_preview.lua b/extra/pandoc_filter/markdownized_preview.lua
new file mode 100644
index 000000000..1626341d5
--- /dev/null
+++ b/extra/pandoc_filter/markdownized_preview.lua
@@ -0,0 +1,14 @@
+image_count = 0
+
+function Image(el)
+  image_count = image_count + 1
+
+  local alt = pandoc.utils.stringify(el.caption)
+
+  if alt == "" then
+    local ext = el.src:match("%.([^.]+)$") or "img"
+    alt = image_count .. "." .. ext
+  end
+
+  return pandoc.Str("[🖼️ " .. alt .. "] ")
+end
\ No newline at end of file
